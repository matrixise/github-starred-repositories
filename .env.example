# GitHub personal access token (required scopes: read:user)
# If not set, the script will fall back to `gh auth token`
GITHUB_TOKEN=ghp_your_token_here

# PostgreSQL connection used by the CLI
DATABASE_URL=postgresql://starred:starred@localhost:5432/starred

# Credentials for the PostgreSQL container in compose.yaml
POSTGRES_USER=starred
POSTGRES_PASSWORD=starred
POSTGRES_DB=starred
POSTGRES_PORT=5432

# Obsidian vault path and export settings
OBSIDIAN_VAULT=~/src/2nd-brain
OBSIDIAN_MIN_SCORE=4
OBSIDIAN_TAG=github/starred
